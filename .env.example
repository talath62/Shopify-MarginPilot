# Copier en .env : cp .env.example .env
# Ne jamais commiter .env.

# PostgreSQL local (docker-compose.yml)
POSTGRES_USER=marginpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marginpilot
POSTGRES_PORT=5432

# Prisma (doit correspondre aux valeurs ci-dessus)
DATABASE_URL="postgresql://marginpilot:change-me@localhost:5432/marginpilot?schema=public"

# Variables Shopify : injectées automatiquement par `shopify app dev` en local.
# À définir uniquement hors CLI (production) :
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=
